# ============== Supabase (Client + Server) ==============
# 在 Supabase 项目设置 → API 获取。
# 浏览器端只使用 anon key；service_role 严禁加 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...server-only

# ============== AI Provider (OpenAI 兼容) ==============
# 仅服务端使用；不暴露到浏览器。
# 未配置时 AI 助手会进入降级模式，基础功能仍可使用。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# 可选：单次请求最长等待时间（毫秒）
AI_TIMEOUT_MS=20000

# ============== Tencent Docs Adapter (可选) ==============
# 不配置时腾讯文档同步功能降级为"仅链接管理"。
# 具体实现见 src/lib/tencent-docs/，仅服务端使用。
TENCENT_DOCS_BASE_URL=
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=

# ============== App ==============
NEXT_PUBLIC_APP_URL=http://localhost:3000
