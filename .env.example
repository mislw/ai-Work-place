# ============== Supabase (Client + Server) ==============
# 在 Supabase 项目设置 → API 获取。
# 浏览器端只使用 anon key；service_role 严禁加 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...server-only

# ============== AI Provider (OpenAI 兼容) ==============
# 仅服务端使用；不暴露到浏览器。
# 未配置时 AI 助手会进入降级模式，基础功能仍可使用。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# 可选：单次请求最长等待时间（毫秒）
AI_TIMEOUT_MS=20000

# ============== Tencent Docs Adapter (可选) ==============
# 不配置时腾讯文档同步功能降级为"仅链接管理"。
# 具体实现见 src/lib/tencent-docs/，仅服务端使用。
TENCENT_DOCS_BASE_URL=
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=

# ============== App ==============
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local visual preview only. It is ignored in production.
NEXT_PUBLIC_ENABLE_AUTH_PREVIEW=false
# 单用户登录映射，仅服务端使用。
LOGIN_USERNAME=mislw
LOGIN_EMAIL=your-account@example.com

# ============== Harness Embed ==============
NEXT_PUBLIC_HARNESS_ORIGIN=https://agent.example.com
# Server-only values. Leave blank in examples and generate a strong secret for deployment.
HARNESS_EMBED_SECRET=
HARNESS_OWNER_USER_ID=

# ============== Knowledge Inbox (server + worker only) ==============
# 原文件私有存储根目录。生产环境应挂载到 NAS 数据卷，不要放进 Git。
KNOWLEDGE_STORAGE_ROOT=/data/knowledge
# 单文件上限，最大允许 52428800 (50 MB)。
KNOWLEDGE_MAX_FILE_BYTES=52428800
# Tesseract OCR 语言包；默认中文简体 + 英文。
KNOWLEDGE_OCR_LANGUAGES=chi_sim+eng
# PostgreSQL 队列空闲轮询间隔（毫秒）。
KNOWLEDGE_WORKER_POLL_MS=1500
# SUPABASE_SERVICE_ROLE_KEY 同样供上传 Route 和 Worker 使用，必须保持 server-only，
# 严禁改名为 NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY 或写进浏览器代码。
