{
	admin off
}

:8080 {
	@health {
		method GET
		path /health
	}
	handle @health {
		respond "ok" 200
	}

	@models {
		method GET
		path /models
	}
	handle @models {
		reverse_proxy https://api.deepseek.com {
			header_up Host api.deepseek.com
			header_up -Cookie
			header_up -Proxy-Authorization
			header_up Authorization "Bearer {$DEEPSEEK_UPSTREAM_API_KEY}"
			header_up x-api-key "{$DEEPSEEK_UPSTREAM_API_KEY}"
		}
	}

	@chat_completions {
		method POST
		path /chat/completions
	}
	handle @chat_completions {
		reverse_proxy https://api.deepseek.com {
			header_up Host api.deepseek.com
			header_up -Cookie
			header_up -Proxy-Authorization
			header_up Authorization "Bearer {$DEEPSEEK_UPSTREAM_API_KEY}"
			header_up x-api-key "{$DEEPSEEK_UPSTREAM_API_KEY}"
		}
	}

	@anthropic_messages {
		method POST
		path /anthropic/v1/messages
	}
	handle @anthropic_messages {
		reverse_proxy https://api.deepseek.com {
			header_up Host api.deepseek.com
			header_up -Cookie
			header_up -Proxy-Authorization
			header_up Authorization "Bearer {$DEEPSEEK_UPSTREAM_API_KEY}"
			header_up x-api-key "{$DEEPSEEK_UPSTREAM_API_KEY}"
		}
	}

	respond 404
}
