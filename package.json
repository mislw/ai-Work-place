{
  "name": "personal-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI Workspace — a personal productivity workstation with calendar, todos, notes, AI and Tencent Docs links, multi-device sync via Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knowledge:worker": "tsx scripts/knowledge-worker.ts",
    "intake:worker": "tsx scripts/intake-worker.ts",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:check": "cargo test --manifest-path apps/desktop/Cargo.toml && cargo check --manifest-path apps/desktop/Cargo.toml",
    "desktop:build": "npm --prefix apps/desktop run build",
    "toolbox:local": "node --import tsx tools/local-toolbox/archive-helper.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@napi-rs/canvas": "^1.0.7",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-type": "^20.5.0",
    "htmlparser2": "^10.0.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.451.0",
    "lunar-typescript": "^1.8.6",
    "mammoth": "^1.12.1",
    "next": "14.2.15",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.12",
    "zod": "^3.23.8",
    "zustand": "^4.5.5",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
